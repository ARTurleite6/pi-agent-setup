{
  "name": "artur-pi-agent-setup",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Pi coding-agent extensions, skills, prompts, theme, and subagent definitions",
  "keywords": [
    "pi-package",
    "coding-agent",
    "developer-tools"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/answer.ts",
      "./extensions/goal.ts",
      "./extensions/notify.ts",
      "./extensions/review.ts",
      "./extensions/subagent/index.ts",
      "./extensions/todos.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
